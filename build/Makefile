# target to build an object file
QCSim/QCSim.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/QCSim.dir/build.make CMakeFiles/QCSim.dir/QCSim/QCSim.cpp.o
.PHONY : QCSim/QCSim.cpp.o

